# Copy privately to /etc/foregather/foregather.env with mode 0600.
# Set a CSPRNG-generated, unpadded base64url 32-byte token. Never put it in app assets.
FOREGATHER_CREATE_TOKEN=REPLACE_WITH_PRIVATE_CREATION_CAPABILITY
# Live remains experimental and disabled unless explicitly opted in.
FOREGATHER_ENABLE_LIVE=0
FOREGATHER_MAX_RECORDS=1024
FOREGATHER_CREATES_PER_MINUTE=60
